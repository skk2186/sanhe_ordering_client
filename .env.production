# 生产环境配置

# 应用标题
VITE_APP_TITLE=回转寿司点餐系统

# API基础URL
VITE_API_BASE_URL=https://api.sushi-system.com

# 是否开启Mock
VITE_USE_MOCK=false

# 是否开启代理
VITE_USE_PROXY=false

# 是否开启HTTPS
VITE_USE_HTTPS=true

# 是否开启PWA
VITE_USE_PWA=true

# 是否开启分析工具
VITE_USE_ANALYZER=false

# 是否开启压缩
VITE_USE_COMPRESS=true

# 压缩算法 gzip | brotli | both
VITE_COMPRESS_TYPE=both

# 是否删除console
VITE_DROP_CONSOLE=true

# 是否删除debugger
VITE_DROP_DEBUGGER=true

# 是否开启兼容性检查
VITE_LEGACY=true

# 是否开启devtools
VITE_DEVTOOLS=false
