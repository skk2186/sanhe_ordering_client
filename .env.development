# 开发环境配置

# 应用标题
VITE_APP_TITLE=回转寿司点餐系统

# API基础URL
VITE_API_BASE_URL=http://localhost:48081
VITE_VOICE_WS_URL=/voice-api/api/v1/ws/transcribe
VITE_VOICE_FINALIZE_TIMEOUT_MS=30000

# 本地后端联调数据
VITE_USE_BACKEND_TEST_AUTH=true
VITE_TEST_MEMBER_ID=24
VITE_SHOP_ID=2
VITE_DESK_ID=77
VITE_DESK_NUMBER=Y1
VITE_DESK_PEOPLE=2

# 应用端口
VITE_PORT=3000

# 是否开启Mock
VITE_USE_MOCK=false

# 是否开启代理
VITE_USE_PROXY=true

# 是否开启HTTPS
VITE_USE_HTTPS=false

# 是否开启PWA
VITE_USE_PWA=false

# 是否开启分析工具
VITE_USE_ANALYZER=false

# 是否开启压缩
VITE_USE_COMPRESS=false

# 压缩算法 gzip | brotli | both
VITE_COMPRESS_TYPE=gzip

# 是否删除console
VITE_DROP_CONSOLE=false

# 是否删除debugger
VITE_DROP_DEBUGGER=false

# 是否开启兼容性检查
VITE_LEGACY=false

# 是否开启devtools
VITE_DEVTOOLS=true
